// 4장 — 바닥
// 목표 플레이 시간 20분. 9월 둘째 주부터 셋째 주. 일주일 내내 비.
// 가르치는 것은 없다. 할 수 있는 것이 줄어든다: 침대, 닫히지 않는 문, 찢어진 머리, 휴대폰.
// 기력은 하루 2. 사흘째에는 모든 선택지가 '눕는다'로 덮인다.
// 위기의 밤에는 모든 행동이 한 번에 성공하고, '목소리'가 다정해진다. 그 다정함이 이 장에서 가장 무서운 것이어야 한다.
//
// ── 지키는 선 (기획서 9장) ──
// 위기의 밤과 22세 회상에서 방법·도구·장소는 화면에도, 대사에도, 소품에도, 효과음에도 없다.
// 위기의 밤은 처음부터 끝까지 방 안이다. 창가에 다가가지 않는다. 커튼 틈은 책상 앞에서 멀리 보이는 것만 쓴다.
// 바느질 도구는 낮에만 나온다. 위기의 밤에는 쓰레기, 슈트, 프로필만 정리한다.
// 응급실 영수증에는 병원, 날짜, 금액만 있다.
// '목소리'는 죽음을 해방이나 만남으로 그리지 않는다. 할머니를 미끼로 쓰지 않는다.
//
// ── 달력 ──
// 3장 목요일은 9월 3일. 4장 첫날은 9월 9일 수요일. 둘째 날은 12일 토요일. 사흘째는 15일 화요일, 할머니의 기일.
// 위기의 밤은 16일 수요일 밤. 날짜는 화면에 쓰지 않는다. 요일만 쓴다. 건너뛴 날은 플레이어도 잃는다.

VAR frag_3 = false        // 과거 조각 3: 할머니와 나비의 사진 (반드시 찾는다)
VAR frag_6 = false        // 과거 조각 6: 장례식장 앞, 응급실, 식탁 (반드시 본다)
VAR c4_box = false        // 실밥의 상자를 열었는가
VAR c4_sewn = false       // 귀를 꿰맸는가
VAR c4_ate = false
VAR c4_eat_n = 0
VAR c4_gom = 0            // 곰표에게 답한 날 수
VAR c4_acts = 0           // 그날 누운 것 말고 한 일
VAR c4_g_n = 0            // 할머니 집 기억을 몇 개 떠올렸는가
VAR c4_toto_read = false  // 토토의 긴 메시지를 그날 열었는가
VAR ending = ""           // A / B / C

// 엔딩 문턱. 임시값. 무작위 플레이 3,000회로 잡았고, 테스트 플레이에서 다시 본다 (기획서 0-11).
