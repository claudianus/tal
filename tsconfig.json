{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
